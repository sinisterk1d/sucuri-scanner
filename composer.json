{
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "3.13.6",
		"wp-coding-standards/wpcs": "3.4.1",
		"dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
		"phpunit/phpunit": "9.6.33",
		"brain/monkey": "2.6.1"
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
