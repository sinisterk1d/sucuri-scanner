# Supply-chain hardening for the Node toolchain.
#
# The published plugin contains no npm code — these packages only build and run
# the test suite. They do, however, execute on developer machines and on the CI
# runners that hold the wordpress.org SVN credentials, so a compromised release
# anywhere in the dependency tree is a credential-disclosure problem, not just a
# broken build.

# Never run a dependency's install lifecycle scripts.
#
# This is the main npm supply-chain vector: an attacker who publishes a malicious
# version of any direct or transitive dependency gets arbitrary code execution the
# moment somebody types `npm install`. No package in the current tree declares a
# preinstall, install, or postinstall script, so turning this off costs nothing
# today and closes the vector outright.
#
# Playwright's browsers are not affected: they are downloaded by an explicit
# `npx playwright install` in `make e2e-install`, not by a lifecycle script.
ignore-scripts=true

# Write exact versions into package.json when adding a dependency, so a caret
# range can never silently widen what a later install resolves to.
save-exact=true

# Keep install output to the point.
fund=false
